{% macro p(config) %}
    {% import 'partials/macro/macro.html.twig' as std %}
    {% import 'classes.html.twig' as classes %}
    {% import 'website/classes.html.twig' as website_classes %}

    {% set text = config.text ?? null %}
    {% set attr = config.attr ?? {} %}
    {% set type = config.type ?? 'app' %}

    {% if type == 'app' %}
        {% set attr = attr|attachClass(classes.p()|trim) %}
    {% elseif type == 'website' %}
        {% set attr = attr|attachClass(website_classes.p()|trim) %}
    {% endif %}

    {% set attr = attr|attachClass(config.fontWeight ?? 'font-medium') %}

    <p {{ std.attr(attr) }}>
        {{- text -}}
    </p>
{% endmacro %}
