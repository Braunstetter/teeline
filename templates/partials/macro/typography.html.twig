{% macro h1(config) %}
    {% set text = config.text ?? null %}

    <h1 class="max-w-2xl text-balance text-5xl font-semibold tracking-tight text-ink sm:text-7xl lg:col-span-2 xl:col-auto">
        {{- text -}}
    </h1>
{% endmacro %}

{% macro h2(config) %}
    {% import 'partials/macro/macro.html.twig' as std %}
    {% import 'classes.html.twig' as classes %}

    {% set text = config.text ?? null %}
    {% set attr = config.attr ?? {} %}
    {% set attr = attr|attachClass(classes.h2()|trim) %}

    <h2 {{ std.attr(attr) }}>
        {{- text -}}
    </h2>
{% endmacro %}

