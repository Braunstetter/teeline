{% use 'form_div_layout.html.twig' %}
{% use 'partials/block/_uploads_form_fields.html.twig' %}

{%- block form_start -%}
    {% import 'classes.html.twig' as classes %}
    {%- set attr = attr|merge({class: attr.class|default('space-y-6')}) -%}
    {{- parent() -}}
    {%- for error in form.vars.errors -%}
        <p class="{{ classes.alert() }}" role="alert">{{ error.message }}</p>
    {%- endfor -%}
{%- endblock form_start -%}

{%- block widget_attributes -%}
    {% import 'classes.html.twig' as classes %}
    {%- set attr = attr|merge({class:
        attr.class|default(widget_class|default(classes.form_input(disabled)))
        ~ (errors|length ? ' ' ~ widget_errors_class|default(classes.form_input_error()))
    }) -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block form_label -%}
    {% import 'classes.html.twig' as classes %}
    {%- set label_attr = label_attr|merge({class: label_attr.class|default(label_class|default(classes.form_label()))}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_help -%}
    {% import 'classes.html.twig' as classes %}
    {%- set help_attr = help_attr|merge({class: help_attr.class|default(help_class|default(classes.form_help()))}) -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {% import 'classes.html.twig' as classes %}
    {%- if errors|length > 0 and form is not rootform -%}
        <ul class="mt-1 space-y-1">
            {%- for error in errors -%}
                <li class="{{ classes.form_error() }}" id="{{ id }}_error{{ loop.index }}">{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block checkbox_row -%}
    {% import 'partials/macro/macro.html.twig' as std %}
    {%- set row_attr = row_attr|merge({class: row_attr.class|default('block w-full')}) -%}
    <div{{ std.attr(row_attr) }}>
        <div class="flex items-start gap-3">
            <div class="flex h-6 shrink-0 items-center">
                {{- form_widget(form) -}}
            </div>
            <div>
                {{- form_label(form) -}}
                {{- form_help(form) -}}
            </div>
        </div>
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {% import 'classes.html.twig' as classes %}
    {%- set widget_class = widget_class|default(classes.form_checkbox()) -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block radio_widget -%}
    {% import 'classes.html.twig' as classes %}
    {%- set widget_class = widget_class|default(classes.form_radio()) -%}
    {{- parent() -}}
{%- endblock radio_widget -%}

{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({class: attr.class|default('mt-2 space-y-2')}) -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form %}
            <label class="flex cursor-pointer items-center gap-3 text-sm/6 text-ink">
                {{- form_widget(child) -}}
                <span>{{ choice_translation_domain is same as(false) ? child.vars.label : child.vars.label|trans({}, choice_translation_domain) }}</span>
            </label>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block submit_widget -%}
    {% import 'classes.html.twig' as classes %}
    {%- set attr = attr|merge({
        class: attr.class|default(classes.btn('primary', 'md')|trim ~ ' min-w-32')
    }) -%}

    <div class="pt-5 flex justify-end">
        {{- parent() -}}
    </div>
{%- endblock submit_widget -%}

{%- block button_attributes -%}
    {% import 'classes.html.twig' as classes %}
    {%- set attr = attr|merge({class: attr.class|default(button_class|default(classes.btn() ~ ' w-full'))}) -%}
    {{- parent() -}}
{%- endblock button_attributes -%}
