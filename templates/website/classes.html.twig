{%- macro h1() -%}
    {{- 'text-pretty text-4xl leading-snug tracking-tight sm:text-5xl lg:text-6xl' -}}
{%- endmacro -%}

{%- macro h2() -%}
    {{- 'text-balance text-3xl leading-snug font-semibold tracking-tight sm:text-4xl lg:text-5xl' -}}
{%- endmacro -%}

{%- macro p() -%}
    {{- 'text-pretty text-lg/8 text-ink' -}}
{%- endmacro -%}

{%- macro quote() -%}
    {{- 'text-pretty text-xl/8 sm:text-2xl/9 text-brand-strong tracking-wide' -}}
{%- endmacro -%}

{%- macro note() -%}
    {{- 'text-sm/6 text-ink-muted' -}}
{%- endmacro -%}

{# Tailwind safelist: [&>strong]:text-lg [&>strong]:font-semibold [&>strong]:text-brand-strong #}
{%- macro label(prefix = '') -%}
    {%- set prefix = prefix ? prefix ~ ':' : '' -%}
    {{- prefix ~ 'text-lg ' ~ prefix ~ 'font-semibold ' ~ prefix ~ 'text-brand-strong' -}}
{%- endmacro -%}

{%- macro container() -%}
    {{- 'w-full max-w-[84rem] mx-auto px-4 sm:px-6' -}}
{%- endmacro -%}

{%- macro screenshot_frame() -%}
    {{- 'relative overflow-hidden rounded-2xl shadow-xl ring-1 ring-black/10' -}}
{%- endmacro -%}
