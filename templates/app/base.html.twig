{% extends 'base.html.twig' %}

{% import 'classes.html.twig' as classes %}
{% import 'partials/macro/typography.html.twig' as typography %}

{% trans_default_domain 'app' %}

{% block title %}{{ page_title|default('') }}{% endblock %}

{% block body %}
    {# First link in the document, or keyboard users tab through the whole navigation. #}
    <a href="#main-content"
       class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-100 focus:rounded-xl focus:bg-surface-raised focus:px-4 focus:py-2 focus:text-brand focus:shadow-lg focus:outline-2 focus:outline-brand">
        {{- 'skip_to_content'|trans -}}
    </a>

    <div data-controller="turbo-confirm" class="relative isolate flex min-h-svh w-full bg-surface max-lg:flex-col">
        {% include 'app/partials/sidebar.html.twig' %}
        {% include 'app/partials/header_mobile.html.twig' %}

        <main id="main-content" class="flex flex-1 flex-col max-md:pt-14 md:min-w-0 md:py-6 lg:py-12 lg:pr-2 md:pl-64">
            <div class="{{ classes.content_row() }} flex-1">
                {% block content_before %}{% endblock %}

                {# The title lives inside the panel -- outside it floats on the page
                   background and the panel reads as a separate box. #}
                <div class="{{ classes.content_container() }}">
                    {% block content %}

                        {% if page_title is defined %}

                            <h1 class="sr-only">{{ page_title }}</h1>

                            <div class="flex flex-col xs:flex-row xs:items-center xs:justify-between gap-4 pt-3 mb-12">
                                <div>
                                    <p id="page-tagline" class="{{ classes.tagline() }}">{% block page_tagline %}{{ page_tagline|default('') }}{% endblock %}</p>

                                    {% if show_page_title is not defined or show_page_title is not same as(false) %}
                                        {{ typography.h3({ text: page_title, attr: {id: 'page-title'} }) }}
                                    {% endif %}
                                </div>

                                {% set actions %}{% block page_actions %}{% endblock %}{% endset %}
                                {% if actions|trim %}
                                    <div class="flex items-center gap-4 w-fit ml-auto xs:ml-0">{{ actions|raw }}</div>
                                {% endif %}
                            </div>
                        {% endif %}

                        {% block page_content %}{% endblock %}

                        {% set page_footer %}{% block page_footer %}{% endblock %}{% endset %}
                        {% if page_footer|trim %}
                            <div class="mt-12 max-w-prose">{{ page_footer|raw }}</div>
                        {% endif %}

                    {% endblock %}
                </div>
            </div>

            {% include 'partials/_turbo_destroy_dialog.html.twig' %}
            {% include 'app/flashMessages/notification/_notifications.html.twig' %}
        </main>
    </div>
{% endblock %}

{% block meta %}
    <meta name="turbo-prefetch" content="false">
    <meta name="turbo-cache-control" content="no-cache">
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
{% endblock %}

{% block stylesheets %}{{ reprise_entry_link_tags('app') }}{% endblock %}
{% block javascripts %}{{ reprise_entry_script_tags('app') }}{% endblock %}
